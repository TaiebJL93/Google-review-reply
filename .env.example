# Gemini API key used by app/generation.py to draft review responses.
# Get a free key at https://aistudio.google.com/apikey — never commit the real value.
GEMINI_API_KEY=your-key-here

# Signs the login session cookie (app/config.py, app/main.py). Optional — an
# unset value falls back to a random key generated at process start, which
# just means everyone is logged out whenever the server restarts. Set a long
# random string here to keep sessions across restarts.
# SECRET_KEY=

# Marks the session cookie Secure (HTTPS only). scripts/start-public.ps1 sets
# this for you when publishing through Cloudflare Tunnel; don't set it for
# plain http://127.0.0.1 use, the browser would then drop the cookie.
# SECURE_COOKIES=true

# Optional: override the SQLite database file location, or point at Postgres.
# The Cloudflare-hosted app uses a Neon Postgres URL (set as a Cloudflare
# secret, not here); `postgres://` URLs are accepted too.
# DATABASE_URL=sqlite:///./reviewreply.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Business Profile OAuth — only needed to use "Connect Google" on the
# dashboard. Requires an approved Business Profile API access request; see
# the "Connecting a Google Business Profile account" section in README.md.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match the redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
