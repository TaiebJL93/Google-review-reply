# Gemini API key used by app/generation.py to draft review responses.
# Get a free key at https://aistudio.google.com/apikey — never commit the real value.
GEMINI_API_KEY=your-key-here

# Signs the login session cookie (app/config.py, app/main.py). Optional locally
# — an unset value falls back to a random key generated at process start,
# which just means everyone's session resets on dev-server restart. Required
# in production so a redeploy or restart doesn't log every user out; Render
# generates this automatically (see render.yaml's generateValue: true).
# SECRET_KEY=

# Optional: override the SQLite database file location, or point at a
# hosted Postgres for production (e.g. a Neon connection string) — see
# "Deploying for free" in README.md. sqlalchemy + psycopg2-binary handle
# either URL scheme with no code changes.
# DATABASE_URL=sqlite:///./reviewreply.db
# DATABASE_URL=postgresql://user:password@host/dbname

# Google Business Profile OAuth — only needed to use "Connect Google" on the
# dashboard. Requires an approved Business Profile API access request; see
# the "Connecting a Google Business Profile account" section in README.md.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match the redirect URI registered on the OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
